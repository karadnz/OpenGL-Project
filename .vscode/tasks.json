{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMakeMac",
            "type": "shell",
            "command": "cmake",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "args": [
                ".." 
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn":[
                "makedir"
            ]
        },
        {
            "label": "BuildMac",
            "type": "shell",
            "command": "${workspaceFolder}/run.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMakeDebugBuild",
            "type": "shell",
            "command": "cmake",
            "options": {
                "cwd": "${workspaceFolder}/../../builds/${workspaceFolderBasename}"
            },
            "args": [
                "-DCMAKE_BUILD_TYPE=Debug",
                "${workspaceFolder}",
                "-G",
                "MinGW Makefiles"
            ]
        },
        {
            "label": "MakeBuild",
            "type": "shell",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}/../../builds/${workspaceFolderBasename}"
            }
        },
        {
            "label": "BuildKlasoruSil",
            "type": "shell",
            "command": "rmdir",
            "options": {
                "cwd": "${workspaceFolder}/../../builds"
            },
            "args": [
                "/s",
                "${workspaceFolderBasename}"
            ]
        },
        {
            "label": "makedir",
            "type": "shell",
            "command": "mkdir -p build",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn":[
                "BuildKlasoruOlustur"
            ]
        }
    ]
}